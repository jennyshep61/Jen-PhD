import matplotlib.pyplot as plt

# --------------------------------------------------
# Pre-mortality baseline
# --------------------------------------------------

MORTALITY_YEAR = 2020

harz_modis_plot = craig_modis_annual.copy()
harz_hls_plot = craigellachie_hls_annual.copy()

# Mean NDVI before mortality

modis_baseline = (
    craig_modis_plot
    .loc[craig_modis_plot["year"] < MORTALITY_YEAR, "ndvi"]
    .mean()
)

hls_baseline = (
    craigellachie_hls_plot
    .loc[craigellachie_hls_plot["year"] < MORTALITY_YEAR, "NDVI"]
    .mean()
)

# Calculate percentage change

craig_modis_plot["pct_change"] = (
    100 *
    (craig_modis_plot["ndvi"] - modis_baseline)
    / modis_baseline
)

craigellachie_hls_plot["pct_change"] = (
    100 *
    (craigellachie_hls_plot["NDVI"] - hls_baseline)
    / hls_baseline
)

# --------------------------------------------------
# Plot
# --------------------------------------------------

fig, ax = plt.subplots(figsize=(9, 5))

# Shade post-mortality period

ax.axvspan(
    MORTALITY_YEAR,
    max(
        craig_modis_plot["year"].max(),
        craigellachie_hls_plot["year"].max()
    ),
    color="red",
    alpha=0.10,
    label="Post-mortality period"
)

# MODIS

ax.plot(
    craig_modis_plot["year"],
    craig_modis_plot["pct_change"],
    "-o",
    color="forestgreen",
    linewidth=2,
    markersize=6,
    label="MODIS"
)

# HLS

ax.plot(
    craigellachie_hls_plot["year"],
    craigellachie_hls_plot["pct_change"],
    "-o",
    color="black",
    linewidth=2,
    markersize=6,
    label="HLS"
)

# Mortality year

ax.axvline(
    MORTALITY_YEAR,
    color="red",
    linestyle="--",
    linewidth=2,
    label="Observed mortality (2020)"
)

# Reference line

ax.axhline(
    0,
